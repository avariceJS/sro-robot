# Copy to .env and fill locally. Never commit .env or real credentials.
APP_DEBUG=1
APP_SECRET_KEY=
# Per-process PostgreSQL pool; size + overflow is the maximum per process.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=5
# Enable only after migration 7af0f5c2d441 has been safely applied.
OCR_TASK_LEASES_ENABLED=0
SRO_LOGIN=
SRO_PASSWORD=
