# Copy to .env and fill locally. Never commit .env or real credentials.
APP_DEBUG=1
APP_SECRET_KEY=
# Optional exact cloud website origin (HTTPS, lowercase ASCII DNS, no trailing slash).
# Requires APP_DEBUG=0. The helper download grants only this additional website.
APP_PUBLIC_ORIGIN=
# Local-only PostgreSQL and Redis settings. Use strong random passwords, and keep
# each URL password synchronized with the corresponding container password.
# Use a 32+ character hexadecimal REDIS_PASSWORD for the generated Redis config.
POSTGRES_USER=sro
POSTGRES_DB=sro
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# These URLs are required in both debug and production modes.
DATABASE_URL=
REDIS_URL=
# Production requires a distinct database role used only by `init-db` / Alembic.
MIGRATION_DATABASE_URL=
# Per-process PostgreSQL pool; size + overflow is the maximum per process.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=5
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
# Enable only after migration 7af0f5c2d441 has been safely applied.
OCR_TASK_LEASES_ENABLED=0
# Per-process request-body bounds for login and multipart upload.
UPLOAD_MAX_FILES=20
UPLOAD_MAX_BATCH_FILES=100
UPLOAD_MAX_FILE_BYTES=26214400
UPLOAD_MAX_BATCH_BYTES=104857600
UPLOAD_MAX_REQUEST_BYTES=110100480
UPLOAD_MAX_CONCURRENT_REQUESTS=2
UPLOAD_BODY_READ_TIMEOUT_SECONDS=300
LOGIN_MAX_CONCURRENT_REQUESTS=2
LOGIN_BODY_READ_TIMEOUT_SECONDS=30
SRO_LOGIN=
SRO_PASSWORD=
