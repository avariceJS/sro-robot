{
  "manifest_version": 3,
  "name": "СРО Робот — помощник КАД",
  "version": "0.1.1",
  "description": "Поиск дела и открытие его документов в обычной вкладке КАД.",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {"strict_min_version": "128"}
  },
  "permissions": ["storage"],
  "host_permissions": ["https://kad.arbitr.ru/*"],
  "background": {
    "scripts": ["protocol.js", "background.js"],
    "service_worker": "background.js"
  },
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{
    "matches": ["https://kad.arbitr.ru/*"],
    "js": ["automation.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
