{
  "manifest_version": 3,
  "name": "СРО Робот — помощник КАД",
  "version": "0.1.0",
  "description": "Поиск дела и открытие его документов в обычной вкладке КАД.",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "host_permissions": ["https://kad.arbitr.ru/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{
    "matches": ["https://kad.arbitr.ru/*"],
    "js": ["automation.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
