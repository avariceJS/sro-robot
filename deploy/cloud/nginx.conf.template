# Install only after replacing __SRO_DOMAIN__ with a validated DNS name and
# confirming the matching Let's Encrypt certificate has been issued.

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    access_log off;
    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name __SRO_DOMAIN__;
    access_log off;
    return 308 https://__SRO_DOMAIN__$request_uri;
}

server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name _;
    access_log off;

    ssl_certificate /etc/letsencrypt/live/__SRO_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__SRO_DOMAIN__/privkey.pem;

    return 444;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __SRO_DOMAIN__;
    access_log off;

    ssl_certificate /etc/letsencrypt/live/__SRO_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__SRO_DOMAIN__/privkey.pem;

    client_max_body_size 105m;
    add_header Strict-Transport-Security "max-age=86400" always;
    client_body_timeout 300s;
    send_timeout 310s;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 310s;
        proxy_read_timeout 310s;

        proxy_set_header Host __SRO_DOMAIN__;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
