[Unit]
Description=SRO Robot PostgreSQL and Redis Compose services
Requires=docker.service
After=docker.service
PartOf=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/sro-robot
ExecStart=/usr/bin/docker compose --project-name deploy --env-file /opt/sro-robot/.env -f /opt/sro-robot/deploy/docker-compose.dev.yml -f /opt/sro-robot/deploy/cloud/docker-compose.restart.yml up --detach --pull never --wait --wait-timeout 60
RemainAfterExit=yes
TimeoutStartSec=90s

# The original first Compose file is /opt/sro-robot/deploy/docker-compose.dev.yml,
# so its project name and named volumes are deploy, deploy_pgdata and
# deploy_redisdata. Keep this explicit project identity. This unit has no
# down/remove action. Docker owns container restart through the paired Compose
# overlay; this oneshot unit only brings the containers up at boot or when
# Docker restarts. The overlay is pending actual deployment qualification.

[Install]
# Enable only after production role/schema and verified-backup preflight.
WantedBy=multi-user.target
