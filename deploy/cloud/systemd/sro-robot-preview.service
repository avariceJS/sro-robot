[Unit]
Description=SRO Robot isolated employee form preview (Save is blocked)
After=network-online.target sro-robot-infra.service
Wants=network-online.target
Requires=sro-robot-infra.service
PartOf=sro-robot-infra.service

[Service]
Type=simple
User=srorobot
Group=srorobot
WorkingDirectory=/opt/sro-robot/current
Environment=APP_DEBUG=0
Environment=SRO_UPLOAD_DIR=/opt/sro-robot/storage/documents
Environment=SRO_PROFILE_DIR=/opt/sro-robot/storage/browser-profiles
Environment=SRO_OUT_DIR=/opt/sro-robot/storage/previews
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/sro-robot/browsers
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/sro-robot/current/.venv/bin/python /opt/sro-robot/current/scripts/dev/run_worker.py sro_preview
Restart=on-failure
RestartSec=5s
TimeoutStopSec=660s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sro-robot/storage/documents /opt/sro-robot/storage/previews /opt/sro-robot/storage/browser-profiles

[Install]
# Reconcile and preserve legacy preview queue entries before enabling.
WantedBy=multi-user.target
