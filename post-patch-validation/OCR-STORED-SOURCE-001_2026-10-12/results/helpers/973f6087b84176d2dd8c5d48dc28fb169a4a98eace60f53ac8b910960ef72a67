from __future__ import annotations

import hashlib
import os
from pathlib import Path
import subprocess
import sys
import time
import uuid

IMAGE = "postgres@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea"
CONTENT = b"%PDF-1.7 synthetic worker source bytes"
CONTENT_HASH = hashlib.sha256(CONTENT).hexdigest()
TAMPERED = b"synthetic modified worker source"


def run(*argv: str, capture: bool = False, env: dict[str, str] | None = None) -> str:
    completed = subprocess.run(
        argv,
        check=True,
        text=True,
        stdout=subprocess.PIPE if capture else subprocess.DEVNULL,
        stderr=subprocess.PIPE if capture else subprocess.DEVNULL,
        env=env,
    )
    return completed.stdout.strip() if capture else ""


def main(mode: str) -> None:
    if mode not in {"behavior", "control", "exploit", "tamper", "symlink", "security"}:
        raise SystemExit("unsupported probe mode")

    container = f"sro-ppv-worker-source-{os.getpid()}-{uuid.uuid4().hex[:8]}"
    run(
        "docker", "run", "--rm", "-d", "--name", container,
        "-p", "127.0.0.1::5432", "-e", "POSTGRES_HOST_AUTH_METHOD=trust", IMAGE,
    )
    try:
        for attempt in range(30):
            ready = subprocess.run(
                ["docker", "exec", container, "pg_isready", "-h", "127.0.0.1", "-p", "5432", "-U", "postgres"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            if ready.returncode == 0:
                break
            if attempt == 29:
                raise RuntimeError("disposable PostgreSQL did not become ready")
            time.sleep(1)

        host_port = run("docker", "port", container, "5432/tcp", capture=True).rsplit(":", 1)[1]
        url = f"postgresql+psycopg://postgres@127.0.0.1:{host_port}/postgres"
        storage = Path(os.environ["PPV_SCRATCH"]) / "private-documents"
        storage.mkdir(mode=0o700)
        storage.chmod(0o700)
        env = os.environ.copy()
        env.update({
            "APP_DEBUG": "1",
            "DATABASE_URL": url,
            "MIGRATION_DATABASE_URL": url,
            "REDIS_URL": "redis://127.0.0.1:1/0",
            "SRO_UPLOAD_DIR": str(storage),
        })
        os.environ.update(env)
        run(sys.executable, "-m", "app.cli", "init-db", env=env)

        from app.db.base import SessionLocal, engine
        from app.db.models import Document, IntakeSource, Task, TaskStatus
        from app.settings import settings
        from app.services.tasks import _write_document_file
        from app.workers import jobs
        from sro_robot.core.models import DebtorCard

        settings.ocr_task_leases_enabled = False
        if mode in {"behavior", "control", "security"}:
            document_path = storage / "valid-source.pdf"
            _write_document_file(document_path, CONTENT)
        elif mode == "exploit":
            document_path = Path(os.environ["PPV_SCRATCH"]) / "outside-root.pdf"
            document_path.write_bytes(CONTENT)
            document_path.chmod(0o600)
        elif mode == "tamper":
            document_path = storage / "tampered-source.pdf"
            document_path.write_bytes(TAMPERED)
            document_path.chmod(0o600)
        else:
            outside_target = Path(os.environ["PPV_SCRATCH"]) / "symlink-target.pdf"
            outside_target.write_bytes(CONTENT)
            outside_target.chmod(0o600)
            document_path = storage / "linked-source.pdf"
            document_path.symlink_to(outside_target)

        with SessionLocal() as db:
            document = Document(
                filename="synthetic.pdf",
                stored_path=str(document_path),
                content_hash=CONTENT_HASH,
                source=IntakeSource.upload,
            )
            db.add(document)
            db.flush()
            task = Task(
                document_id=document.id,
                scenario="person",
                profile="default",
                status=TaskStatus.new,
                recognized={},
                values={},
            )
            db.add(task)
            db.commit()
            task_id = task.id

        parse_calls = []

        class ParserProbe:
            def parse(self, path: str) -> DebtorCard:
                data = Path(path).read_bytes()
                parse_calls.append(data)
                if mode in {"behavior", "control", "security"}:
                    assert data == CONTENT
                elif mode == "tamper":
                    assert data == TAMPERED
                else:
                    assert data == CONTENT
                print("PPV_REACHED", flush=True)
                return DebtorCard()

        jobs._require_current_worker_schema(task_id)
        original_profile = jobs.get_profile
        try:
            jobs.get_profile = lambda _name: ParserProbe()
            jobs.recognize(task_id)
        finally:
            jobs.get_profile = original_profile

        with SessionLocal() as db:
            task = db.get(Task, task_id)
            status = task.status
            error = task.error

        if mode in {"behavior", "control", "security"}:
            assert status == TaskStatus.needs_review
            assert len(parse_calls) == 1
            print("task_state=needs_review; parser_calls=1; source=verified", flush=True)
        else:
            if parse_calls:
                assert status == TaskStatus.needs_review
                raise AssertionError("OCR parser opened an unsafe stored-document reference")
            else:
                assert status == TaskStatus.failed
                assert error == "Document recognition failed (ExistingDocumentUnavailable)"
                print("task_state=failed; parser_calls=0; source=withheld", flush=True)
        engine.dispose()
    finally:
        subprocess.run(["docker", "rm", "-f", container], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


if __name__ == "__main__":
    main(sys.argv[1])
