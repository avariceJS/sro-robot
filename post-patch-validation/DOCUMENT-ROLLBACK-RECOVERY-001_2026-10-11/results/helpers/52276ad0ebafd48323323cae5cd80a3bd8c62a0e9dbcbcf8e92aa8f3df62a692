from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import stat
import sys
import tempfile
from types import SimpleNamespace

from app.db.models import IntakeSource
from app.services import tasks


class FakeSession:
    def __init__(self, *, fail_flush: bool = False) -> None:
        self.fail_flush = fail_flush
        self.documents = []

    def get_bind(self):
        return SimpleNamespace(dialect=SimpleNamespace(name="sqlite"))

    def scalar(self, _statement):
        # Model a fresh transaction whose database has no committed document row.
        return None

    def add(self, document) -> None:
        self.documents.append(document)

    def flush(self) -> None:
        if self.fail_flush:
            self.fail_flush = False
            raise RuntimeError("synthetic database flush failure")


def _expected_path(storage: Path, content: bytes) -> Path:
    return storage / f"{hashlib.sha256(content).hexdigest()}.pdf"


def _set_private_directory(directory: str) -> Path:
    storage = Path(directory) / "documents"
    storage.mkdir(mode=0o700)
    if os.name == "posix":
        storage.chmod(0o700)
    tasks.settings.upload_dir = storage
    return storage


def _new_document(db: FakeSession, content: bytes):
    return tasks.store_document(db, "synthetic.pdf", content, IntakeSource.upload)


def control() -> None:
    content = b"synthetic new upload control"
    with tempfile.TemporaryDirectory() as directory:
        storage = _set_private_directory(directory)
        db = FakeSession()
        document = _new_document(db, content)
        result = {
            "content_matches": Path(document.stored_path).read_bytes() == content,
            "filename": document.filename,
            "hash_matches": document.content_hash == hashlib.sha256(content).hexdigest(),
            "mode": stat.S_IMODE(Path(document.stored_path).stat().st_mode)
            if os.name == "posix"
            else None,
            "stored_name": Path(document.stored_path).name,
            "row_count": len(db.documents),
            "storage_is_private": stat.S_IMODE(storage.stat().st_mode) == 0o700
            if os.name == "posix"
            else True,
        }
        print(json.dumps(result, sort_keys=True))
        assert result["content_matches"] and result["hash_matches"] and result["row_count"] == 1


def _assert_retry_after_orphan(content: bytes, *, flush_failure: bool) -> bool:
    with tempfile.TemporaryDirectory() as directory:
        storage = _set_private_directory(directory)
        original = FakeSession(fail_flush=flush_failure)
        try:
            _new_document(original, content)
        except RuntimeError as error:
            if not flush_failure or str(error) != "synthetic database flush failure":
                raise
        else:
            if flush_failure:
                raise AssertionError("failure injection did not reach the database flush")
        # The successful flush is rolled back, while a raised flush is rolled
        # back by the transaction owner; neither leaves a committed row.
        original.documents.clear()

        path = _expected_path(storage, content)
        orphan_is_present_without_committed_row = path.is_file() and not original.documents
        retry = FakeSession()
        try:
            document = _new_document(retry, content)
        except (FileExistsError, OSError):
            return False
        return (
            orphan_is_present_without_committed_row
            and document.stored_path == str(path)
            and path.read_bytes() == content
            and document.content_hash == hashlib.sha256(content).hexdigest()
            and len(retry.documents) == 1
        )


def exploit() -> None:
    safe_retry = _assert_retry_after_orphan(
        b"synthetic file persisted before a database transaction rollback",
        flush_failure=False,
    )
    print("PPV_REACHED", flush=True)
    assert safe_retry, "same-content retry did not recover the verified orphan file"


def variant() -> None:
    safe_retry = _assert_retry_after_orphan(
        b"synthetic file persisted before a database flush failure",
        flush_failure=True,
    )
    print("PPV_REACHED", flush=True)
    assert safe_retry, "same-content retry did not recover after flush failure"


def behavior() -> None:
    content = b"synthetic legitimate first-upload behavior"
    with tempfile.TemporaryDirectory() as directory:
        storage = _set_private_directory(directory)
        db = FakeSession()
        document = _new_document(db, content)
        result = {
            "content_matches": Path(document.stored_path).read_bytes() == content,
            "filename": document.filename,
            "hash_matches": document.content_hash == hashlib.sha256(content).hexdigest(),
            "mode": stat.S_IMODE(Path(document.stored_path).stat().st_mode)
            if os.name == "posix"
            else None,
            "stored_name": Path(document.stored_path).name,
            "row_count": len(db.documents),
        }
        print(json.dumps(result, sort_keys=True))


def security() -> None:
    content = b"synthetic existing symlink target"
    with tempfile.TemporaryDirectory() as directory:
        storage = _set_private_directory(directory)
        target = storage / "preserved-target.pdf"
        target.write_bytes(content)
        if os.name == "posix":
            target.chmod(0o600)
        destination = _expected_path(storage, content)
        destination.symlink_to(target)
        db = FakeSession()
        refused = False
        try:
            _new_document(db, content)
        except OSError:
            refused = True
        assert refused, "existing symlink path was accepted"
        assert destination.is_symlink(), "symlink path was replaced"
        assert target.read_bytes() == content, "symlink target was modified"
        assert not db.documents, "document row was staged for an untrusted symlink"


def main() -> None:
    modes = {
        "control": control,
        "exploit": exploit,
        "variant": variant,
        "behavior": behavior,
        "security": security,
    }
    mode = sys.argv[1]
    modes[mode]()


if __name__ == "__main__":
    main()
