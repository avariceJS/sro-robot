from __future__ import annotations

import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time
import uuid

PROJECT = Path.cwd()
sys.path.insert(0, str(PROJECT))
PYTHON = sys.executable
DOCKER = "/usr/local/bin/docker"
CASE = sys.argv[1]

def run(argv: list[str], *, env: dict[str, str] | None = None, timeout: int = 180) -> subprocess.CompletedProcess[str]:
    return subprocess.run(argv, cwd=PROJECT, env=env, text=True, capture_output=True, timeout=timeout, check=False)

def start_database() -> tuple[str, str, tempfile.TemporaryDirectory[str]]:
    container = f"sro-ppv-{uuid.uuid4().hex[:12]}"
    upload = tempfile.TemporaryDirectory(prefix="sro-ppv-upload-")
    created = subprocess.run(
        [DOCKER, "run", "--rm", "-d", "--name", container, "-p", "127.0.0.1::5432",
         "-e", "POSTGRES_HOST_AUTH_METHOD=trust", "postgres:16-alpine"],
        text=True, capture_output=True, timeout=20, check=False,
    )
    if created.returncode:
        raise RuntimeError(f"disposable PostgreSQL start failed: {created.stderr}")
    try:
        for _ in range(40):
            ready = subprocess.run([DOCKER, "exec", container, "pg_isready", "-U", "postgres"],
                                   text=True, capture_output=True, timeout=5, check=False)
            if ready.returncode == 0:
                break
            time.sleep(0.25)
        else:
            raise RuntimeError("disposable PostgreSQL did not become ready")
        published = subprocess.run([DOCKER, "port", container, "5432/tcp"],
                                   text=True, capture_output=True, timeout=5, check=False)
        if published.returncode:
            raise RuntimeError("disposable PostgreSQL port lookup failed")
        host_port = published.stdout.strip().rsplit(":", 1)[1]
        env = {
            **os.environ,
            "DATABASE_URL": f"postgresql+psycopg://postgres@127.0.0.1:{host_port}/postgres",
            "APP_DEBUG": "1",
            "SRO_UPLOAD_DIR": upload.name,
            "SRO_TEST_POSTGRES": "1",
        }
        migrated = run([PYTHON, "-m", "app.cli", "init-db"], env=env, timeout=30)
        if migrated.returncode:
            raise RuntimeError(f"disposable PostgreSQL migration failed: {migrated.stdout}{migrated.stderr}")
        return container, env["DATABASE_URL"], upload
    except BaseException:
        subprocess.run([DOCKER, "rm", "-f", container], capture_output=True, timeout=10, check=False)
        upload.cleanup()
        raise

def remove_database(container: str, upload: tempfile.TemporaryDirectory[str]) -> None:
    result = subprocess.run([DOCKER, "rm", "-f", container], text=True,
                            capture_output=True, timeout=10, check=False)
    upload.cleanup()
    if result.returncode and container in result.stderr:
        raise RuntimeError("disposable PostgreSQL cleanup failed")

def with_database(callback) -> None:
    container, database_url, upload = start_database()
    env = {**os.environ, "DATABASE_URL": database_url, "APP_DEBUG": "1",
           "SRO_UPLOAD_DIR": upload.name, "SRO_TEST_POSTGRES": "1"}
    try:
        # Verify the exact ephemeral Docker endpoint and install the DB URL in
        # this process before importing any application module or ORM engine.
        from sqlalchemy.engine import make_url
        parsed = make_url(database_url)
        identity = subprocess.run(
            [DOCKER, "inspect", "--format", "{{.State.Running}}|{{.Config.Image}}", container],
            text=True, capture_output=True, timeout=5, check=False,
        )
        published = subprocess.run(
            [DOCKER, "port", container, "5432/tcp"],
            text=True, capture_output=True, timeout=5, check=False,
        )
        expected = f"127.0.0.1:{parsed.port}"
        if (parsed.get_backend_name() != "postgresql" or parsed.host != "127.0.0.1"
                or identity.returncode or identity.stdout.strip() != "true|postgres:16-alpine"
                or published.returncode or expected not in published.stdout.splitlines()):
            raise RuntimeError("synthetic database identity check failed")
        os.environ.update(env)
        callback(env)
    finally:
        remove_database(container, upload)

def create_task(source: str = "upload") -> int:
    from app.db.base import session_scope
    from app.db.models import Document, IntakeSource, Task, TaskStatus
    with session_scope() as db:
        document = Document(filename="synthetic.pdf", stored_path="/tmp/synthetic.pdf",
                             content_hash=uuid.uuid4().hex, source=IntakeSource(source))
        db.add(document)
        db.flush()
        task = Task(document_id=document.id, scenario="person", profile="default",
                    status=TaskStatus.new, recognized={}, values={})
        db.add(task)
        db.flush()
        return task.id

def case_control(env: dict[str, str]) -> None:
    from app.db.base import session_scope
    from app.services.leases import claim_ocr, complete_ocr
    from sro_robot.core.models import DebtorCard
    task_id = create_task()
    with session_scope() as db:
        first = claim_ocr(db, task_id)
    if first is None:
        raise AssertionError("initial claim was denied")
    with session_scope() as db:
        duplicate = claim_ocr(db, task_id)
    if duplicate is not None:
        raise AssertionError("active lease admitted a duplicate claim")
    with session_scope() as db:
        completed = complete_ocr(db, first, DebtorCard())
    if not completed:
        raise AssertionError("current owner could not complete a valid claim")
    print("initial_claim=True duplicate_denied=True completion=True")

def case_stale_identity(env: dict[str, str]) -> None:
    from datetime import timedelta
    from sqlalchemy import func, select, update
    from app.db.base import SessionLocal, session_scope
    from app.db.models import Task, TaskLease
    from app.services.leases import claim_ocr, complete_ocr
    from sro_robot.core.models import DebtorCard
    task_id = create_task()
    stale = SessionLocal()
    try:
        task = stale.get(Task, task_id)
        tx_start = stale.scalar(select(func.now()))
        if task.status.value != "new":
            raise AssertionError("synthetic fixture was not new")
        with session_scope() as db:
            first = claim_ocr(db, task_id)
        with session_scope() as db:
            if not complete_ocr(db, first, DebtorCard()):
                raise AssertionError("first owner failed to complete")
            db.execute(update(TaskLease).where(TaskLease.task_id == task_id).values(
                lease_until=tx_start - timedelta(seconds=1)))
        reclaimed = claim_ocr(stale, task_id)
        print("PPV_REACHED", flush=True)
        assert reclaimed is None, "completed task was reclaimed through stale ORM state"
        stale.rollback()
    finally:
        stale.close()

def case_stale_lease(env: dict[str, str]) -> None:
    from datetime import datetime, timedelta, timezone
    from app.db.base import SessionLocal, session_scope
    from app.db.models import Task, TaskLease
    from app.services.leases import claim_ocr
    task_id = create_task()
    with session_scope() as db:
        first = claim_ocr(db, task_id)
    with session_scope() as db:
        lease = db.get(TaskLease, task_id)
        lease.lease_until = datetime.now(timezone.utc) - timedelta(seconds=10)
    stale = SessionLocal()
    try:
        task = stale.get(Task, task_id)
        lease = stale.get(TaskLease, task_id)
        if task.status.value != "recognizing":
            raise AssertionError("synthetic fixture was not recognizing")
        with session_scope() as db:
            second = claim_ocr(db, task_id)
        if second is None or second.attempt != 2:
            raise AssertionError("expired first lease was not reclaimed")
        duplicate = claim_ocr(stale, task_id)
        print("PPV_REACHED", flush=True)
        assert duplicate is None, "stale ORM lease admitted a third concurrent attempt"
        stale.rollback()
    finally:
        stale.close()

def case_clock(env: dict[str, str]) -> None:
    from sqlalchemy import func, select, text, update
    from app.db.base import SessionLocal, session_scope
    from app.db.models import TaskLease
    from app.services.leases import claim_ocr, complete_ocr
    from sro_robot.core.models import DebtorCard
    task_id = create_task()
    with session_scope() as db:
        claim = claim_ocr(db, task_id)
    stale = SessionLocal()
    try:
        tx_start = stale.scalar(select(func.now()))
        with session_scope() as db:
            lease_until = db.execute(update(TaskLease).where(TaskLease.task_id == task_id).values(
                lease_until=func.clock_timestamp() + text("interval '300 milliseconds'"))
                .returning(TaskLease.lease_until)).scalar_one()
        if not tx_start < lease_until:
            raise AssertionError("timing harness did not start its lease after the transaction")
        time.sleep(0.5)
        accepted = complete_ocr(stale, claim, DebtorCard())
        print("PPV_REACHED", flush=True)
        assert not accepted, "completion accepted after lease expiry"
        stale.rollback()
    finally:
        stale.close()

def case_clock_claim(env: dict[str, str]) -> None:
    from sqlalchemy import func, select, text, update
    from app.db.base import SessionLocal, session_scope
    from app.db.models import TaskLease
    from app.services.leases import claim_ocr
    task_id = create_task()
    with session_scope() as db:
        first = claim_ocr(db, task_id)
    stale = SessionLocal()
    try:
        tx_start = stale.scalar(select(func.now()))
        with session_scope() as db:
            lease_until = db.execute(update(TaskLease).where(TaskLease.task_id == task_id).values(
                lease_until=func.clock_timestamp() + text("interval '300 milliseconds'"))
                .returning(TaskLease.lease_until)).scalar_one()
        if not tx_start < lease_until:
            raise AssertionError("timing harness did not start its lease after the transaction")
        time.sleep(0.5)
        reclaimed = claim_ocr(stale, task_id)
        print("PPV_REACHED", flush=True)
        assert reclaimed is not None and reclaimed.attempt == 2, "expired lease was not reclaimed"
        stale.rollback()
    finally:
        stale.close()

def case_security(env: dict[str, str]) -> None:
    from app.db.base import session_scope
    from app.db.models import Task, TaskLease
    from app.services.leases import claim_ocr
    task_id = create_task(source="kad")
    with session_scope() as db:
        task = db.get(Task, task_id)
        accepted = claim_ocr(db, task_id)
        lease = db.get(TaskLease, task_id)
        if accepted is not None or task.status.value != "new" or lease is not None:
            raise AssertionError("OCR lease claimed a non-upload source")
    print("non_upload_source_not_claimed=True")

def case_test(env: dict[str, str], name: str) -> None:
    result = run([PYTHON, "-m", "unittest", name], env=env, timeout=60)
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    if result.returncode:
        raise SystemExit(result.returncode)

def main() -> None:
    if CASE == "suite":
        with_database(lambda env: case_test(env, "tests.test_task_leases_postgres"))
        return
    def callback(env: dict[str, str]) -> None:
        if CASE == "control":
            case_control(env)
        elif CASE == "stale-identity":
            case_stale_identity(env)
        elif CASE == "stale-lease":
            case_stale_lease(env)
        elif CASE == "clock":
            case_clock(env)
        elif CASE == "clock-claim":
            case_clock_claim(env)
        elif CASE == "behavior":
            case_test(env, "tests.test_task_leases_postgres.PostgreSQLTaskLeaseTests.test_expired_claim_is_reclaimed_and_late_result_and_failure_are_fenced")
        elif CASE == "regression":
            case_test(env, "tests.test_task_leases_postgres.PostgreSQLTaskLeaseTests.test_concurrent_duplicate_delivery_has_exactly_one_claim")
        elif CASE == "security":
            case_security(env)
        else:
            raise SystemExit(f"unknown validation case: {CASE}")
    with_database(callback)

if __name__ == "__main__":
    main()
