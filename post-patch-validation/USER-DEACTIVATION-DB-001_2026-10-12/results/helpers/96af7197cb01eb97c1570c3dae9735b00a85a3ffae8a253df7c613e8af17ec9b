def run(arguments: list[str], *, env=None, timeout=60) -> str:
    result = subprocess.run(
        arguments,
        check=True,
        capture_output=True,
        text=True,
        env=env,
        timeout=timeout,
    )
    return result.stdout.strip()


def database() -> tuple[str, str]:
    container = f"sro-ppv-deactivate-{uuid.uuid4().hex[:12]}"
    run(
        [
            "docker", "run", "--rm", "-d", "--name", container,
            "-p", "127.0.0.1::5432", "-e", "POSTGRES_HOST_AUTH_METHOD=trust", IMAGE,
        ]
    )
    try:
        for _ in range(60):
            ready = subprocess.run(
                ["docker", "exec", container, "pg_isready", "-h", "127.0.0.1", "-p", "5432", "-U", "postgres"],
                check=False, capture_output=True, text=True, timeout=5,
            )
            if ready.returncode == 0:
                break
            time.sleep(0.25)
        else:
            raise RuntimeError("disposable PostgreSQL did not become ready")
        address = run(["docker", "port", container, "5432/tcp"])
        port = address.rsplit(":", 1)[1]
        url = f"postgresql+psycopg://postgres@127.0.0.1:{port}/postgres"
        env = os.environ.copy()
        env.update(
            APP_DEBUG="1",
            DATABASE_URL=url,
            MIGRATION_DATABASE_URL=url,
            REDIS_URL="redis://synthetic:synthetic@127.0.0.1:1/0",
            PYTHONPATH=os.environ["PPV_CHECKOUT"],
        )
        run([PYTHON, "-m", "app.cli", "init-db"], env=env, timeout=120)
        return container, url
    except BaseException:
        subprocess.run(["docker", "rm", "-f", container], check=False, capture_output=True)
        raise


def insert_identity(engine, *, suffix: str) -> tuple[int, str]:
    token = f"synthetic-{suffix}-{uuid.uuid4().hex}"
    digest = hashlib.sha256(token.encode()).hexdigest()
    with engine.begin() as connection:
        user_id = connection.execute(
            text(
                'INSERT INTO public."user" '
                '(login, full_name, password_hash, sro_login, is_active) '
                "VALUES (:login, 'Synthetic User', 'synthetic-only', 'synthetic', true) "
                "RETURNING id"
            ),
            {"login": f"synthetic-ppv-{uuid.uuid4().hex}"},
        ).scalar_one()
        connection.execute(
            text(
                "INSERT INTO public.login_session "
                "(user_id, token_sha256, expires_at, revoked_at) "
                "VALUES (:user_id, :digest, :expires_at, NULL)"
            ),
            {
                "user_id": user_id,
                "digest": digest,
                "expires_at": datetime.now(timezone.utc) + timedelta(days=1),
            },
        )
    return user_id, digest


def revoked_at(engine, digest: str):
    with engine.connect() as connection:
        return connection.execute(
            text("SELECT revoked_at FROM public.login_session WHERE token_sha256 = :digest"),
            {"digest": digest},
        ).scalar_one()


def exercise(mode: str) -> None:
    container, url = database()
    engine = create_engine(url, connect_args={"connect_timeout": 5})
    try:
        user_id, digest = insert_identity(engine, suffix=mode)
        if mode == "control":
            with engine.begin() as connection:
                connection.execute(
                    text('UPDATE public."user" SET full_name = :name WHERE id = :id'),
                    {"name": "Synthetic Updated User", "id": user_id},
                )
            assert revoked_at(engine, digest) is None
            print("unrelated_user_update_preserves_session")
        elif mode in {"exploit", "variant"}:
            with engine.begin() as connection:
                connection.execute(
                    text('UPDATE public."user" SET is_active = false WHERE id = :id'),
                    {"id": user_id},
                )
                if mode == "variant":
                    connection.execute(
                        text('UPDATE public."user" SET is_active = true WHERE id = :id'),
                        {"id": user_id},
                    )
            observed = revoked_at(engine, digest)
            print("PPV_REACHED", flush=True)
            assert observed is not None, (
                "direct SQL account deactivation left a browser session active"
            )
            print(f"direct_deactivation_session_revoked={observed is not None}")
        elif mode == "regression":
            from app.db.models import LoginSession, User
            from app.services import auth

            with Session(engine) as session, session.begin():
                _, revoked = auth.deactivate_user(
                    session,
                    session.execute(
                        text('SELECT login FROM public."user" WHERE id = :id'),
                        {"id": user_id},
                    ).scalar_one(),
                )
                assert revoked == 1
                session_row = session.scalar(
                    text("SELECT revoked_at FROM public.login_session WHERE token_sha256 = :digest"),
                    {"digest": digest},
                )
                assert session_row is not None
            print("supported_deactivation_reports_and_revokes_one_session")
        elif mode == "security":
            with engine.begin() as connection:
                connection.execute(
                    text('UPDATE public."user" SET is_active = true WHERE id = :id'),
                    {"id": user_id},
                )
            assert revoked_at(engine, digest) is None
            print("active_account_noop_preserves_session")
        else:
            raise ValueError("unknown mode")
    finally:
        engine.dispose()
        subprocess.run(["docker", "rm", "-f", container], check=False, capture_output=True)


