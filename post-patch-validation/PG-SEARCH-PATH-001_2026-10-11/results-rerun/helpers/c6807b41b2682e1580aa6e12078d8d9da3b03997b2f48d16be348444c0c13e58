from __future__ import annotations

import os
from pathlib import Path
import subprocess
import sys
import time
import uuid


mode = sys.argv[1]
checkout = Path(os.environ["PPV_CHECKOUT"])
scratch = Path(os.environ["PPV_SCRATCH"])
upload_dir = scratch / "documents"
upload_dir.mkdir(mode=0o700)
container = f"sro-ppv-search-path-{uuid.uuid4().hex[:12]}"


def run(argv: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(argv, check=check, capture_output=True, text=True)


run([
    "docker", "run", "--rm", "-d", "--name", container,
    "-p", "127.0.0.1::5432",
    "-e", "POSTGRES_HOST_AUTH_METHOD=trust",
    "postgres:16-alpine",
])
try:
    for _ in range(30):
        ready = run(["docker", "exec", container, "pg_isready", "-U", "postgres"], check=False)
        if ready.returncode == 0:
            break
        time.sleep(1)
    else:
        raise RuntimeError("disposable PostgreSQL did not become ready")

    published = run(["docker", "port", container, "5432/tcp"]).stdout.strip()
    if not published.startswith("127.0.0.1:"):
        raise RuntimeError("disposable PostgreSQL did not bind to loopback")
    port = published.rsplit(":", 1)[1]
    setup = [
        "docker", "exec", container, "psql", "-U", "postgres", "-d", "postgres",
        "-v", "ON_ERROR_STOP=1",
        "-c", "CREATE ROLE runtime_probe LOGIN",
        "-c", "CREATE ROLE migration_probe LOGIN",
    ]
    if mode == "default":
        setup.extend([
            "-c", "ALTER ROLE runtime_probe IN DATABASE postgres SET search_path TO public",
            "-c", "ALTER ROLE migration_probe IN DATABASE postgres SET search_path TO public",
        ])
    else:
        setup.extend([
            "-c", "CREATE SCHEMA runtime_shadow AUTHORIZATION runtime_probe",
            "-c", "CREATE SCHEMA migration_shadow AUTHORIZATION migration_probe",
            "-c", "ALTER ROLE runtime_probe IN DATABASE postgres SET search_path TO runtime_shadow, public",
            "-c", "ALTER ROLE migration_probe IN DATABASE postgres SET search_path TO migration_shadow, public",
            "-c", "CREATE TABLE runtime_shadow.user (id integer)",
            "-c", "CREATE TABLE migration_shadow.alembic_version (version_num varchar(32))",
        ])
    run(setup)
    role_config = run([
        "docker", "exec", container, "psql", "-U", "postgres", "-d", "postgres",
        "-At", "-c",
        "SELECT role.rolname || ':' || setting.setconfig::text FROM pg_db_role_setting AS setting "
        "JOIN pg_roles AS role ON role.oid = setting.setrole "
        "WHERE role.rolname IN ('runtime_probe', 'migration_probe') ORDER BY role.rolname",
    ]).stdout.strip()
    print(f"configured_role_search_path={role_config}")

    runtime_url = f"postgresql+psycopg://runtime_probe@127.0.0.1:{port}/postgres"
    migration_url = f"postgresql+psycopg://migration_probe@127.0.0.1:{port}/postgres"
    selected_schema = "runtime_schema" if mode == "runtime" else "migration_schema"
    code = f"""
import app.db.base as database_base
from app.db.base import engine, migration_engine
from sqlalchemy import text

with engine.connect() as connection:
    runtime_schema, runtime_path = connection.execute(text("SELECT current_schema(), current_setting('search_path')")).one()
with migration_engine.connect() as connection:
    migration_schema, migration_path = connection.execute(text("SELECT current_schema(), current_setting('search_path')")).one()
engine.dispose()
migration_engine.dispose()
print(f'loaded_database_base={{database_base.__file__}}', flush=True)
print(f'runtime_schema={{runtime_schema}} runtime_path={{runtime_path}} migration_schema={{migration_schema}} migration_path={{migration_path}}', flush=True)
{"print('PPV_REACHED', flush=True)" if mode in ("runtime", "migration") else ""}
{"assert " + selected_schema + " == 'public', '" + mode + "_search_path selected a role-specific shadow schema'" if mode in ("runtime", "migration") else "assert runtime_schema == 'public' and migration_schema == 'public'"}
print('{mode}_search_path=pinned_to_public')
"""
    environment = {
        "DATABASE_URL": runtime_url,
        "MIGRATION_DATABASE_URL": migration_url,
        "APP_DEBUG": "1",
        "SRO_UPLOAD_DIR": str(upload_dir),
        "PYTHONPATH": str(checkout),
    }
    result = run([
        "/Users/root1/Desktop/sro-robot/.venv/bin/python", "-c", code,
    ], check=False)
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    raise SystemExit(result.returncode)
finally:
    run(["docker", "stop", container], check=False)
