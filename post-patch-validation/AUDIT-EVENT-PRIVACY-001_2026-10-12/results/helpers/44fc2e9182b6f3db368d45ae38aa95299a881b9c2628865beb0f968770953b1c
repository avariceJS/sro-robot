from __future__ import annotations

import sys
from unittest.mock import MagicMock

from app.services.tasks import log


def event_after(*args, **kwargs):
    db = MagicMock()
    log(db, None, *args, **kwargs)
    return db.add.call_args.args[0], db


mode = sys.argv[1]
if mode == "control":
    row, _db = event_after("duplicate", "untrusted", payload={"count": 3})
    assert (row.kind, row.message, row.payload) == (
        "duplicate",
        "Duplicate document detected",
        {"count": 3},
    )
    print("CONTROL_OK", flush=True)
elif mode == "exploit":
    sensitive = "Synthetic Person 12345.pdf OCR fragment"
    row, _db = event_after("failed", sensitive)
    print("PPV_REACHED", flush=True)
    assert sensitive not in row.message
    assert row.message == "Обработка завершилась ошибкой; требуется проверка"
elif mode == "variant":
    db = MagicMock()
    rejected = False
    try:
        log(
            db,
            None,
            "fields_saved",
            "ignored",
            payload={"submitted_fields": {"name": "Synthetic Person"}},
        )
    except ValueError:
        rejected = True
    print("PPV_REACHED", flush=True)
    assert rejected and db.add.call_count == 0
elif mode == "behavior":
    row, _db = event_after("duplicate", "Duplicate document detected", payload={"count": 3})
    print(f"{row.kind}|{row.message}|{row.payload['count']}")
elif mode == "security":
    request_id = "a" * 32
    row, _db = event_after(
        "session_login_failed",
        "attempted identity and password must not be supplied",
        payload={"request_id": request_id},
    )
    assert row.payload == {"request_id": request_id}
    assert "attempted identity" not in row.message
    print("ADJACENT_SECURITY_OK", flush=True)
else:
    raise SystemExit(f"unknown mode: {mode}")
