from __future__ import annotations

import hashlib
import os
from pathlib import Path
import subprocess
import sys
import time
import uuid

IMAGE = "postgres@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea"
CONTENT = b"%PDF-1.7 synthetic stored-document reference probe"
CONTENT_HASH = hashlib.sha256(CONTENT).hexdigest()


def run(*argv: str, capture: bool = False) -> str:
    completed = subprocess.run(
        argv,
        check=True,
        text=True,
        stdout=subprocess.PIPE if capture else subprocess.DEVNULL,
        stderr=subprocess.PIPE if capture else subprocess.DEVNULL,
    )
    return completed.stdout.strip() if capture else ""


def main(mode: str) -> None:
    if mode not in {"behavior", "exploit", "variant", "security"}:
        raise SystemExit("unsupported probe mode")

    container = f"sro-ppv-doc-reference-{os.getpid()}-{uuid.uuid4().hex[:8]}"
    run(
        "docker", "run", "--rm", "-d", "--name", container,
        "-p", "127.0.0.1::5432", "-e", "POSTGRES_HOST_AUTH_METHOD=trust", IMAGE,
    )
    try:
        for attempt in range(30):
            ready = subprocess.run(
                ["docker", "exec", container, "pg_isready", "-h", "127.0.0.1", "-p", "5432", "-U", "postgres"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            if ready.returncode == 0:
                break
            if attempt == 29:
                raise RuntimeError("disposable PostgreSQL did not become ready")
            time.sleep(1)

        host_port = run("docker", "port", container, "5432/tcp", capture=True).rsplit(":", 1)[1]
        url = f"postgresql+psycopg://postgres@127.0.0.1:{host_port}/postgres"
        storage = Path(os.environ["PPV_SCRATCH"]) / "private-documents"
        storage.mkdir(mode=0o700)
        storage.chmod(0o700)
        os.environ.update({
            "APP_DEBUG": "1",
            "DATABASE_URL": url,
            "MIGRATION_DATABASE_URL": url,
            "REDIS_URL": "redis://127.0.0.1:1/0",
            "SRO_UPLOAD_DIR": str(storage),
        })

        from app.db.base import SessionLocal, engine
        from app.db.models import Document, IntakeSource, User
        from app.services import tasks

        User.__table__.create(engine)
        Document.__table__.create(engine)
        try:
            if mode == "behavior":
                with SessionLocal() as db:
                    created = tasks.store_document(db, "synthetic.pdf", CONTENT, IntakeSource.upload)
                    created_id = created.id
                    db.commit()
                with SessionLocal() as db:
                    reused = tasks.store_document(db, "other-name.pdf", CONTENT, IntakeSource.upload)
                    assert reused.id == created_id
                    assert Path(reused.stored_path).read_bytes() == CONTENT
                    print("PPV_REACHED", flush=True)
                    print("valid_private_document_reused=true", flush=True)
                return

            if mode in {"exploit", "variant"}:
                if mode == "exploit":
                    stored_path = Path(os.environ["PPV_SCRATCH"]) / "outside.pdf"
                    stored_path.write_bytes(CONTENT)
                    stored_path.chmod(0o600)
                else:
                    stored_path = storage / "corrupted.pdf"
                    stored_path.write_bytes(b"tampered synthetic bytes")
                    stored_path.chmod(0o600)

                with SessionLocal() as db:
                    record = Document(
                        filename="synthetic.pdf",
                        stored_path=str(stored_path),
                        content_hash=CONTENT_HASH,
                        source=IntakeSource.upload,
                    )
                    db.add(record)
                    db.commit()

                print("PPV_REACHED", flush=True)
                try:
                    with SessionLocal() as db:
                        tasks.store_document(db, "retry.pdf", CONTENT, IntakeSource.upload)
                except tasks.ExistingDocumentUnavailable:
                    print("unsafe_document_reference=rejected", flush=True)
                    return
                raise AssertionError("existing unsafe document reference was reused")

            with SessionLocal() as db:
                created = tasks.store_document(db, "synthetic.pdf", CONTENT, IntakeSource.upload)
                db.commit()
                document_id = created.id
            with SessionLocal() as db:
                reused = tasks.store_document(db, "synthetic.pdf", CONTENT, IntakeSource.upload)
                assert reused.id == document_id
                db.rollback()
            print("same-content service operation remains available", flush=True)
        finally:
            engine.dispose()
    finally:
        subprocess.run(["docker", "rm", "-f", container], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


if __name__ == "__main__":
    main(sys.argv[1])
